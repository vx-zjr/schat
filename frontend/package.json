{
  "name": "schat-frontend-monorepo",
  "private": true,
  "workspaces": [
    "shared",
    "admin",
    "user"
  ],
  "scripts": {
    "build:shared": "npm --workspace=shared run build",
    "dev:admin": "npm --workspace=admin run dev",
    "dev:user": "npm --workspace=user run dev",
    "build:admin": "npm --workspace=admin run build",
    "build:user": "npm --workspace=user run build"
  }
}
