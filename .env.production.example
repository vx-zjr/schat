NODE_ENV=production
DOMAIN=api.example.com
LETSENCRYPT_EMAIL=admin@example.com

POSTGRES_DB=schat
POSTGRES_USER=schat
POSTGRES_PASSWORD=change-me-postgres
DATABASE_URL=postgresql://schat:change-me-postgres@postgres:5432/schat

REDIS_URL=redis://redis:6379
SOCKET_IO_REDIS_ENABLED=true

JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000
MASTER_USERNAME=master
MASTER_PASSWORD=change-me-master-password

MINIO_ROOT_USER=schat
MINIO_ROOT_PASSWORD=change-me-minio-password
S3_ENDPOINT=http://minio:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=schat-media
S3_ACCESS_KEY=schat
S3_SECRET_KEY=change-me-minio-password
S3_SIGNED_URL_TTL_SECONDS=300

LIVEKIT_URL=ws://livekit:7880
LIVEKIT_API_KEY=schat-livekit-key
LIVEKIT_API_SECRET=change-me-livekit-secret

GEOIP_DATA_DIR=/app/data/geoip
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
FCM_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS=/app/secrets/firebase-service-account.json
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=com.schat.mobile
APNS_KEY_PATH=/app/secrets/AuthKey.p8
APNS_PRODUCTION=false
BACKUP_DIR=./backups
BACKUP_ENCRYPTION_PASSWORD=change-me-backup-password
